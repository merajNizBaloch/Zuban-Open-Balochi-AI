# Zubán model adapters
#
# Chat + Translate
# OpenAI-compatible POST /chat/completions endpoint.
# Example: https://router.huggingface.co/v1/chat/completions
ZUBAN_TEXT_API_URL=
ZUBAN_TEXT_API_KEY=
ZUBAN_TEXT_MODEL=

# Speech-to-text
# Multipart/form-data endpoint receiving:
#   file=<audio>
#   model=<optional model id>
# Expected JSON: { "text": "..." }
ZUBAN_STT_API_URL=
ZUBAN_STT_API_KEY=
ZUBAN_STT_MODEL=

# Text-to-speech
# JSON endpoint receiving:
#   { "text": "...", "model": "..." }
# Expected response: audio/*
ZUBAN_TTS_API_URL=
ZUBAN_TTS_API_KEY=
ZUBAN_TTS_MODEL=

# OCR
# Multipart/form-data endpoint receiving:
#   file=<image>
#   model=<optional model id>
# Expected JSON: { "text": "..." }
ZUBAN_OCR_API_URL=
ZUBAN_OCR_API_KEY=
ZUBAN_OCR_MODEL=
