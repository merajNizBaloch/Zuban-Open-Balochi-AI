# Zubán model adapters
#
# FASTEST WAY TO ENABLE CHAT + TRANSLATE:
# Create a Hugging Face token with "Make calls to Inference Providers" permission.
HF_TOKEN=
ZUBAN_HF_TEXT_MODEL=Qwen/Qwen3-8B:cheapest

# Optional: custom OpenAI-compatible text endpoint.
# These take priority over HF_TOKEN when both are configured.
ZUBAN_TEXT_API_URL=
ZUBAN_TEXT_API_KEY=
ZUBAN_TEXT_MODEL=

# Optional local Ollama fallback.
# Example: OLLAMA_BASE_URL=http://localhost:11434
# Example: OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Balochi self-hosted model server:
# services/balochi-model-server
#
# Example local URLs:
# ZUBAN_STT_API_URL=http://localhost:7860/stt
# ZUBAN_TTS_API_URL=http://localhost:7860/tts
# ZUBAN_OCR_API_URL=http://localhost:7860/ocr

ZUBAN_STT_API_URL=
ZUBAN_STT_API_KEY=
ZUBAN_STT_MODEL=Aynkader/Balochi_STT

ZUBAN_TTS_API_URL=
ZUBAN_TTS_API_KEY=
ZUBAN_TTS_MODEL=Aynkader/Balochi-TTS-Three-Speakers

# OCR is usable without this setting: the website falls back to
# Tesseract.js with Urdu + Persian + Arabic language data in the browser.
# A configured endpoint takes priority.
ZUBAN_OCR_API_URL=
ZUBAN_OCR_API_KEY=
ZUBAN_OCR_MODEL=
