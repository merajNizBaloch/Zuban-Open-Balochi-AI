# Zubán model adapters
#
# CHAT + TRANSLATE
#
# Easiest hosted setup:
# Create a Hugging Face token with "Make calls to Inference Providers" permission.
HF_TOKEN=
ZUBAN_HF_TEXT_MODEL=Qwen/Qwen3-8B:cheapest

# Optional custom OpenAI-compatible text endpoint.
# These take priority over HF_TOKEN when configured.
ZUBAN_TEXT_API_URL=
ZUBAN_TEXT_API_KEY=
ZUBAN_TEXT_MODEL=

# Optional local Ollama fallback.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:8b

# BALOCHI SPEECH + VOICE + SERVER OCR
#
# Deploy services/balochi-model-server as one service, then set only its base URL.
# Example:
# ZUBAN_MODEL_SERVER_URL=https://your-space-name.hf.space
ZUBAN_MODEL_SERVER_URL=

# Optional endpoint overrides. Leave empty when using ZUBAN_MODEL_SERVER_URL.
ZUBAN_STT_API_URL=
ZUBAN_STT_API_KEY=
ZUBAN_STT_MODEL=Aynkader/Balochi_STT

ZUBAN_TTS_API_URL=
ZUBAN_TTS_API_KEY=
ZUBAN_TTS_MODEL=Aynkader/Balochi-TTS-Three-Speakers

ZUBAN_OCR_API_URL=
ZUBAN_OCR_API_KEY=
ZUBAN_OCR_MODEL=

# OCR still works when no model server is configured:
# the website falls back to browser Tesseract.js using Urdu + Persian + Arabic
# script models. This is an interim fallback, not a Balochi-specific OCR model.
